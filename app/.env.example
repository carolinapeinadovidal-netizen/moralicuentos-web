# Supabase > Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave secreta: solo en el servidor, nunca en el navegador ni en Git
SUPABASE_SERVICE_ROLE_KEY=

# Clave para firmar las sesiones del panel (mínimo 32 caracteres aleatorios)
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Asistente IA (opcional). Clave de console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=3000
